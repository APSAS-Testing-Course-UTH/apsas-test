# ============================================================================
# APSAS Production Environment - Default Values
# ============================================================================
# This file contains production-ready defaults
# Override sensitive values in .env file or environment variables
# DO NOT commit actual secrets to version control
# ============================================================================

# ============================================================================
# GATEWAY CONFIGURATION
# ============================================================================
GATEWAY_PORT=8080
GATEWAY_VERSION=latest

# ============================================================================
# SERVICE VERSIONS
# ============================================================================
REGISTRY_VERSION=latest
CONFIG_VERSION=latest
IDENTITY_VERSION=latest
CONTENT_VERSION=latest
SUBMISSION_VERSION=latest
EVALUATION_VERSION=latest
SUPPORT_VERSION=latest
NOTIFICATION_VERSION=latest

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=apsas
DB_USERNAME=apsas
# IMPORTANT: Set DB_PASSWORD in .env file
DB_PASSWORD="${DB_PASSWORD}"

# Comment out SEED_DATA line to disable seeding
SEED_DATA=seed-data.sql

# ============================================================================
# RABBITMQ CONFIGURATION
# ============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=apsas
# IMPORTANT: Set RABBITMQ_PASSWORD in .env file
RABBITMQ_PASSWORD="${RABBITMQ_PASSWORD}"
RABBITMQ_PORT=5672

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# IMPORTANT: Set REDIS_PASSWORD in .env file
REDIS_PASSWORD="${REDIS_PASSWORD}"
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ============================================================================
# JWT & SECURITY
# ============================================================================
# IMPORTANT: Set JWT_SECRET in .env file with a strong random value
JWT_SECRET="${JWT_SECRET}"
JWT_EXPIRATION=86400

# ============================================================================
# IDENTITY SERVICE
# ============================================================================
EMAIL_TOKEN_EXPIRATION=86400
PASSWORD_RESET_TOKEN_EXPIRATION=3600

# ============================================================================
# PISTON API CONFIGURATION
# ============================================================================
PISTON_API_URL=http://piston:2000

# ============================================================================
# EMAIL/SMTP CONFIGURATION
# ============================================================================
# IMPORTANT: Configure SMTP settings in .env file
MAIL_HOST="${MAIL_HOST}"
MAIL_PORT=587
MAIL_USERNAME="${MAIL_USERNAME}"
MAIL_PASSWORD="${MAIL_PASSWORD}"
MAIL_PROTOCOL=smtp
MAIL_TLS_ENABLED=true

# Email settings
EMAIL_FROM=noreply@apsas.edu.vn
EMAIL_FROM_NAME="APSAS System"

# ============================================================================
# NOTIFICATION SERVICE URLs
# ============================================================================
# IMPORTANT: Update these with your actual frontend domain
ASSIGNMENT_URL=https://app.apsas.edu.vn/assignments/%id%
SUBMISSION_URL=https://app.apsas.edu.vn/submissions/%id%
SUPPORT_SESSION_URL=https://app.apsas.edu.vn/support/sessions/%id%
VERIFICATION_URL=https://app.apsas.edu.vn/verify-email?token=%token%
RESET_PASSWORD_URL=https://app.apsas.edu.vn/reset-password?token=%token%

# ============================================================================
# FIREBASE CLOUD MESSAGING (FCM) - OPTIONAL
# ============================================================================
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ============================================================================
# ADMIN USER DEFAULTS - For Spring Boot Admin Dashboard
# ============================================================================
ADMIN_USERNAME="${ADMIN_USERNAME}"
ADMIN_PASSWORD="${ADMIN_PASSWORD}"
ADMIN_PORTAL_PORT=9090
ADMIN_PORTAL_URL=http://localhost:9090

# ============================================================================
# OTHER CONFIGURATIONS
# ============================================================================
API_DOCS_ENABLED=false

# Json application settings to override defaults (DO NOT TOUCH)
SPRING_APPLICATION_JSON="{
  \"spring\": {
    \"cloud\": {
      \"config\": {
        \"server\": {
          \"overrides\": {
            \"DB_HOST\": \"${DB_HOST}\",
            \"DB_PORT\": \"${DB_PORT}\",
            \"DB_NAME\": \"${DB_NAME}\",
            \"DB_USERNAME\": \"${DB_USERNAME}\",
            \"DB_PASSWORD\": \"${DB_PASSWORD}\",
            \"RABBITMQ_HOST\": \"${RABBITMQ_HOST}\",
            \"RABBITMQ_USERNAME\": \"${RABBITMQ_USERNAME}\",
            \"RABBITMQ_PASSWORD\": \"${RABBITMQ_PASSWORD}\",
            \"RABBITMQ_PORT\": \"${RABBITMQ_PORT}\",
            \"REDIS_HOST\": \"${REDIS_HOST}\",
            \"REDIS_PORT\": \"${REDIS_PORT}\",
            \"REDIS_PASSWORD\": \"${REDIS_PASSWORD}\",
            \"JWT_SECRET\": \"${JWT_SECRET}\",
            \"JWT_EXPIRATION\": \"${JWT_EXPIRATION}\",
            \"EMAIL_TOKEN_EXPIRATION\": \"${EMAIL_TOKEN_EXPIRATION}\",
            \"PASSWORD_RESET_TOKEN_EXPIRATION\": \"${PASSWORD_RESET_TOKEN_EXPIRATION}\",
            \"PISTON_API_URL\": \"${PISTON_API_URL}\",
            \"MAIL_HOST\": \"${MAIL_HOST}\",
            \"MAIL_PORT\": \"${MAIL_PORT}\",
            \"MAIL_USERNAME\": \"${MAIL_USERNAME}\",
            \"MAIL_PASSWORD\": \"${MAIL_PASSWORD}\",
            \"MAIL_PROTOCOL\": \"${MAIL_PROTOCOL}\",
            \"MAIL_TLS_ENABLED\": \"${MAIL_TLS_ENABLED}\",
            \"EMAIL_FROM\": \"${EMAIL_FROM}\",
            \"EMAIL_FROM_NAME\": \"${EMAIL_FROM_NAME}\",
            \"ASSIGNMENT_URL\": \"${ASSIGNMENT_URL}\",
            \"SUBMISSION_URL\": \"${SUBMISSION_URL}\",
            \"SUPPORT_SESSION_URL\": \"${SUPPORT_SESSION_URL}\",
            \"VERIFICATION_URL\": \"${VERIFICATION_URL}\",
            \"RESET_PASSWORD_URL\": \"${RESET_PASSWORD_URL}\",
            \"FIREBASE_ENABLED\": \"${FIREBASE_ENABLED}\",
            \"FIREBASE_PROJECT_ID\": \"${FIREBASE_PROJECT_ID}\",
            \"FIREBASE_PRIVATE_KEY\": \"${FIREBASE_PRIVATE_KEY}\",
            \"FIREBASE_CLIENT_EMAIL\": \"${FIREBASE_CLIENT_EMAIL}\",
            \"ADMIN_USERNAME\": \"${ADMIN_USERNAME}\",
            \"ADMIN_PASSWORD\": \"${ADMIN_PASSWORD}\",
            \"API_DOCS_ENABLED\": \"${API_DOCS_ENABLED}\",
            \"SEED_DATA\": \"${SEED_DATA}\"
          }
        }
      }
    }
  }
}"
