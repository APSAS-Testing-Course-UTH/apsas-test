top to bottom direction
skinparam linetype ortho

title Content Service Class Diagram

hide empty members


class Assignment {
    createdAt: LocalDateTime
    creatorId: UUID
    description: String
    difficultyLevel: DifficultyLevel
    dueDate: LocalDateTime
    id: UUID
    languages: String[]
    maxScore: BigDecimal
    skills: Set<Skill>
    startDate: LocalDateTime
    status: AssignmentStatus
    testCases: List<TestCase>
    title: String
    tutorials: Set<Tutorial>
    updatedAt: LocalDateTime
}
class AssignmentController {
    + getAllAssignments(PageRequestParams): ResponseEntity<PageResponse<AssignmentResponse>>
    + createAssignment(CreateAssignmentRequest, Authentication): ResponseEntity<AssignmentResponse>
    + updateAssignmentSchedule(UUID, UpdateAssignmentScheduleRequest): ResponseEntity<AssignmentResponse>
    + updateAssignment(UUID, UpdateAssignmentRequest, Authentication): ResponseEntity<AssignmentResponse>
    + deleteAssignment(UUID, Authentication): ResponseEntity<Void>
    + getAssignmentById(UUID): ResponseEntity<AssignmentResponse>
    + publishAssignment(UUID, Authentication): ResponseEntity<AssignmentResponse>
    + archiveAssignment(UUID, Authentication): ResponseEntity<AssignmentResponse>
}
interface AssignmentMapper << interface >> {
    + mapTutorials(Set<Tutorial>): Set<TutorialResponse>
    + toEntity(CreateAssignmentRequest, UUID): Assignment
    + mapSkills(Set<Skill>): Set<SkillResponse>
    + updateEntity(Assignment, UpdateAssignmentRequest): void
    + toResponse(Assignment): AssignmentResponse
}
class AssignmentPublishedEvent {
    assignmentId: UUID
    publishedAt: LocalDateTime
    title: String
}
interface JpaRepository<T, ID> << interface >> {
    note right
        Contains basic CRUD methods:
        save(), findById(), findAll(),
        delete(), deleteById(), etc.
    end note
}

interface AssignmentRepository << interface >>
class AssignmentResponse {
    createdAt: LocalDateTime
    creatorId: UUID
    description: String
    difficultyLevel: DifficultyLevel
    dueDate: LocalDateTime
    id: UUID
    languages: String[]
    maxScore: BigDecimal
    skills: Set<SkillResponse>
    startDate: LocalDateTime
    status: AssignmentStatus
    testCases: List<TestCase>
    title: String
    tutorials: Set<TutorialResponse>
    updatedAt: LocalDateTime
}
class AssignmentScheduleUpdatedEvent {
    assignmentId: UUID
    dueDate: LocalDateTime
    startDate: LocalDateTime
    updatedAt: LocalDateTime
}
class AssignmentService {
    + updateAssignment(UUID, UpdateAssignmentRequest, UUID): AssignmentResponse
    + updateAssignmentSchedule(UUID, UpdateAssignmentScheduleRequest): AssignmentResponse
    + archiveAssignment(UUID, UUID): AssignmentResponse
    + createAssignment(CreateAssignmentRequest, UUID): AssignmentResponse
    + deleteAssignment(UUID, UUID): void
    + publishAssignment(UUID, UUID): AssignmentResponse
    - validateDates(LocalDateTime, LocalDateTime): void
    + getAssignmentById(UUID): AssignmentResponse
    + getAllAssignments(Pageable): PageResponse<AssignmentResponse>
}
enum AssignmentStatus << enumeration >> {
    DRAFT
    PUBLISHED
    ARCHIVED
}
class BaseEvent {
    timestamp: Instant
}
class CreateAssignmentRequest {
    description: String
    difficultyLevel: DifficultyLevel
    dueDate: LocalDateTime
    languages: String[]
    maxScore: BigDecimal
    skillIds: Set<UUID>
    startDate: LocalDateTime
    testCases: List<TestCase>
    title: String
    tutorialIds: Set<UUID>
}
class CreateSkillRequest {
    description: String
    name: String
}
class CreateTutorialRequest {
    content: String
    tags: String[]
    title: String
}
enum DifficultyLevel << enumeration >> {
    EASY
    MEDIUM
    HARD
}
class EventPublisher {
    + publish(String, BaseEvent): void
}
entity PageRequestParams << record >> {
    page(): Integer
    size(): Integer
    toPageable(): Pageable
}
entity PageResponse<T> << record >> {
    content(): List<T>
    first(): boolean
    hasNext(): boolean
    hasPrevious(): boolean
    last(): boolean
    pageNumber(): int
    pageSize(): int
    totalElements(): long
    totalPages(): int
}
class Skill {
    assignments: Set<Assignment>
    createdAt: LocalDateTime
    description: String
    id: UUID
    name: String
    updatedAt: LocalDateTime
}
class SkillController {
    + createSkill(CreateSkillRequest): ResponseEntity<SkillResponse>
    + deleteSkill(UUID): ResponseEntity<Void>
    + getSkillById(UUID): ResponseEntity<SkillResponse>
    + getAllSkills(PageRequestParams): ResponseEntity<PageResponse<SkillResponse>>
    + updateSkill(UUID, UpdateSkillRequest): ResponseEntity<SkillResponse>
}
interface SkillMapper << interface >> {
    + updateEntity(Skill, UpdateSkillRequest): void
    + toEntity(CreateSkillRequest): Skill
    + toResponse(Skill): SkillResponse
}
interface SkillRepository << interface >> {
    + existsByName(String): boolean
}
class SkillResponse {
    createdAt: LocalDateTime
    description: String
    id: UUID
    name: String
    updatedAt: LocalDateTime
}
class SkillService {
    + createSkill(CreateSkillRequest): SkillResponse
    + getAllSkills(Pageable): PageResponse<SkillResponse>
    + getSkillById(UUID): SkillResponse
    + deleteSkill(UUID): void
    + updateSkill(UUID, UpdateSkillRequest): SkillResponse
}
class TestCase {
    description: String
    hidden: Boolean
    input: String
    memoryLimit: Integer
    order: Integer
    output: String
    timeout: Integer
    weight: Double
}
class Tutorial {
    assignments: Set<Assignment>
    content: String
    createdAt: LocalDateTime
    creatorId: UUID
    id: UUID
    tags: String[]
    title: String
    updatedAt: LocalDateTime
}
class TutorialController {
