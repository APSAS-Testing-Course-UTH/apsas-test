    + updateTutorial(UUID, UpdateTutorialRequest, Authentication): ResponseEntity<TutorialResponse>
    + getAllTutorials(PageRequestParams): ResponseEntity<PageResponse<TutorialResponse>>
    + deleteTutorial(UUID, Authentication): ResponseEntity<Void>
    + createTutorial(CreateTutorialRequest, Authentication): ResponseEntity<TutorialResponse>
}
interface TutorialMapper << interface >> {
