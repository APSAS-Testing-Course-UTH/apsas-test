{
  "info": {
    "name": "APSAS Notification Collection",
    "_postman_id": "0dbaf5e0-fd87-467f-9e3a-1137d4a8ed91",
    "description": "Notification service API tests for preferences and devices. Import this file into Insomnia/Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get preference settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/preferences",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "preferences"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has preference fields', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.have.property('emailEnabled');",
                  "  pm.expect(json).to.have.property('pushEnabled');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update preference settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailEnabled\": true,\n  \"pushEnabled\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/preferences",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "preferences"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Preferences updated as expected', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.emailEnabled).to.eql(true);",
                  "  pm.expect(json.pushEnabled).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative - Get preferences with invalid token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{invalid_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/preferences",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "preferences"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 for invalid token', function () {",
                  "  pm.expect(pm.response.code).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "Get all devices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/devices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "devices"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is array', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(Array.isArray(json)).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a new device",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var token = 'dev-' + Date.now() + '-' + Math.random().toString(16).slice(2);",
                  "pm.collectionVariables.set('device_token', token);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Device id returned and stored', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.collectionVariables.set('device_id', json.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{device_token}}\",\n  \"deviceType\": \"web\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/devices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "devices"
              ]
            }
          }
        },
        {
          "name": "Delete a device",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/devices/{{device_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{device_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', function () {",
                  "  pm.expect(pm.response.code).to.eql(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative - Get devices without token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/devices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "devices"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 when missing token', function () {",
                  "  pm.expect(pm.response.code).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "websocket_url",
      "value": "ws://localhost:8080",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "invalid_token",
      "value": "invalid.token.value",
      "type": "string"
    },
    {
      "key": "device_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "device_id",
      "value": "",
      "type": "string"
    }
  ]
}
