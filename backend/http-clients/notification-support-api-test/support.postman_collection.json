              ],
              "path": [
                "api",
                "v1",
                "support",
                "sessions",
                "11111111-1111-1111-1111-111111111111"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404 for missing session', function () {",
                  "  pm.expect(pm.response.code).to.eql(404);",
                  "});"
                ]
              }
            }
          ]
        },
