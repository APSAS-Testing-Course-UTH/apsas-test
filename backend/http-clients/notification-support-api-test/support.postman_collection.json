{
  "info": {
    "name": "APSAS Support Collection",
    "_postman_id": "d7eb5dfa-59e4-4c42-b9d2-0bc968e4f4ef",
    "description": "Support service API tests. Import this file into Insomnia/Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Support Sessions",
      "item": [
        {
          "name": "Get all support sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/support/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "support",
                "sessions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has list payload', function () {",
                  "  var json = pm.response.json();",
                  "  var isArrayPayload = Array.isArray(json);",
                  "  var isPagePayload = json && Array.isArray(json.content);",
                  "  pm.expect(isArrayPayload || isPagePayload).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a support session (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initialMessage\": \"I need help with my assignment.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/support/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "support",
                "sessions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Session id returned and stored', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.collectionVariables.set('support_session_id', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get support session by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/support/sessions/{{support_session_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "support",
                "sessions",
                "{{support_session_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response session id matches variable', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.eql(pm.collectionVariables.get('support_session_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Send message to support session (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"I still cannot solve this issue.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/support/sessions/{{support_session_id}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "support",
                "sessions",
                "{{support_session_id}}",
                "messages"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200/201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Send message to support session (Instructor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instructor_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Instructor response for your session.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/support/sessions/{{support_session_id}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "support",
                "sessions",
                "{{support_session_id}}",
                "messages"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200/201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Close support session (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{student_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/support/sessions/{{support_session_id}}/close",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "support",
                "sessions",
                "{{support_session_id}}",
                "close"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Session is closed', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.isClosed).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative - Get session with invalid id",
          "request": {
