### Get all devices
GET {{BASE_URL}}/api/v1/devices
Authorization: Bearer {{auth_token}}

> {%
  client.test("Fetched all devices successfully", function () {
    client.assert(response.status === 200);
    client.assert(Array.isArray(response.body));
  });
%}

### Register a new device
@device_token = {{$random.uuid}}
POST {{BASE_URL}}/api/v1/devices
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "token": "{{device_token}}",
  "deviceType": "web"
}

> {%
  client.test("Device registered successfully", function () {
    client.assert(response.status === 201);
    client.assert(response.body.id !== undefined);
  });
  client.global.set("device_id", response.body.id);
%}

### Delete a device
@device_id = {{device_id}}
DELETE {{BASE_URL}}/api/v1/devices/{{device_id}}
Authorization: Bearer {{auth_token}}

> {%
  client.test("Device deleted successfully", function () {
    client.assert(response.status === 204);
  });
%}
