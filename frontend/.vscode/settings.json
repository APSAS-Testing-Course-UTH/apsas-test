{
  "files.readonlyInclude": {
    "**/node_modules/**": true,
    "**/.tanstack/**": true,
    "**/routeTree.gen.ts": true,
    "**/openapi/**.json": true,
    "src/api/**": true
  },
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true
  },
  "sonarlint.analysisExcludesStandalone": "src/api/**,src/routeTree.gen.ts,public/mockServiceWorker.js,dist/**,coverage/**",
  "sonarlint.testFilePattern": "**/*.test.ts,**/*.test.tsx,**/*.test.js,**/*.test.jsx,**/*.spec.ts,**/*.spec.tsx,**/*.spec.js,**/*.spec.jsx,**/__tests__/**,src/test/**",
  "sonarlint.disableTelemetry": true,
  "sonarlint.output.showAnalyzerLogs": false,
  "sonarlint.output.showVerboseLogs": false
}
