        expect(data.id).toBe(createdAssignment.id)
        expect(data.title).toBe('Test Assignment')
        expect(data).toHaveProperty('skills')
        expect(data).toHaveProperty('tutorials')
        expect(data).toHaveProperty('testCases')
      })
