    describe('POST /api/v1/assignments', () => {
      it('should create assignment for provider', async () => {
        const newAssignment = {
          title: 'New Assignment',
          description: 'Assignment description',
          difficultyLevel: 'MEDIUM' as const,
          languages: ['javascript', 'python'],
          testCases: [
            {
              order: 1,
              description: 'Test case 1',
              hidden: false,
              weight: 1.0,
              input: 'input1',
              output: 'output1',
              timeout: 5000,
              memoryLimit: 128,
            },
          ],
        }

        const response = await fetch(`/api/v1/assignments`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer provider-token',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(newAssignment),
        })

        expect(response.status).toBe(200)
        const data = await response.json()
        expect(data.title).toBe(newAssignment.title)
        expect(data.description).toBe(newAssignment.description)
        expect(data.difficultyLevel).toBe(newAssignment.difficultyLevel)
        expect(data.languages).toEqual(newAssignment.languages)
        expect(data.status).toBe('DRAFT')
        expect(data).toHaveProperty('id')
        expect(data).toHaveProperty('creatorId')
        expect(data).toHaveProperty('createdAt')
        expect(data).toHaveProperty('updatedAt')
      })

      it('should reject creation for non-provider', async () => {
