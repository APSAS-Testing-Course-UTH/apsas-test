    describe('PATCH /api/v1/assignments/{id}/schedule', () => {
      it('should update assignment schedule for instructor', async () => {
        // First create an assignment
        const createResponse = await fetch(`/api/v1/assignments`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer provider-token',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            title: 'Assignment to Schedule',
            description: 'Description',
            difficultyLevel: 'EASY' as const,
            languages: ['javascript'],
            testCases: [
              {
                order: 1,
                description: 'Test case',
                hidden: false,
                weight: 1.0,
                input: 'input',
                output: 'output',
                timeout: 5000,
                memoryLimit: 128,
              },
            ],
          }),
        })
        const createdAssignment = await createResponse.json()

        const newStartDate = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString() // Tomorrow
        const newDueDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString() // Next week

        const scheduleResponse = await fetch(`/api/v1/assignments/${createdAssignment.id}/schedule`, {
          method: 'PATCH',
          headers: {
            'Authorization': 'Bearer instructor-token',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            startDate: newStartDate,
            dueDate: newDueDate,
          }),
        })

        expect(scheduleResponse.status).toBe(200)
        const scheduledAssignment = await scheduleResponse.json()
        expect(scheduledAssignment.startDate).toBe(newStartDate)
        expect(scheduledAssignment.dueDate).toBe(newDueDate)
      })

      it('should reject schedule update for non-instructor', async () => {
        const response = await fetch(`/api/v1/assignments/some-id/schedule`, {
          method: 'PATCH',
          headers: {
            'Authorization': 'Bearer student-token',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            startDate: new Date().toISOString(),
            dueDate: new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(),
          }),
        })

        expect(response.status).toBe(403)
      })

      it('should validate required schedule fields', async () => {
        // First create an assignment
        const createResponse = await fetch(`/api/v1/assignments`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer provider-token',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            title: 'Assignment for Schedule Validation',
            description: 'Description',
            difficultyLevel: 'EASY' as const,
            languages: ['javascript'],
            testCases: [
              {
                order: 1,
                description: 'Test case',
                hidden: false,
                weight: 1.0,
                input: 'input',
                output: 'output',
                timeout: 5000,
                memoryLimit: 128,
              },
            ],
          }),
        })
        const createdAssignment = await createResponse.json()

        const response = await fetch(`/api/v1/assignments/${createdAssignment.id}/schedule`, {
          method: 'PATCH',
          headers: {
            'Authorization': 'Bearer instructor-token',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({}),
        })

        expect(response.status).toBe(400)
      })
    })
