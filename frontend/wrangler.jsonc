{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apsas-frontend",
  "compatibility_date": "2025-11-18",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "apsas.tozydev.id.vn",
      "custom_domain": true,
    },
  ],
}
