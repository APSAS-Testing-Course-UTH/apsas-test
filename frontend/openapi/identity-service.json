                        "example": 10
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by field(s). Format: field1,direction;field2,direction. Direction can be 'asc' or 'desc'. Multiple sort criteria separated by semicolon.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "createdAt,desc;name,asc"
