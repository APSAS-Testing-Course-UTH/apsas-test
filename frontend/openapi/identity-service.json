                ],
                "summary": "Get users by role",
                "description": "Get users by role with pagination and sorting (Admin and Instructor only)",
                "operationId": "getUsersByRole",
                "parameters": [
                    {
                        "name": "role",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "STUDENT",
                                "INSTRUCTOR",
                                "CONTENT_PROVIDER",
                                "ADMIN"
                            ]
                        }
                    },
                    {
                        "name": "page",
