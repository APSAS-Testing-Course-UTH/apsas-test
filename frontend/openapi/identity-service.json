        "/api/v1/users": {
            "get": {
                "tags": [
                    "User Management"
                ],
                "summary": "Get all users",
                "description": "Get all users with pagination and sorting (Admin only)",
                "operationId": "getAllUsers",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number (0-indexed)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "minimum": 0
