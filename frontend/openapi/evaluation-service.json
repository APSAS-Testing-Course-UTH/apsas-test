{
    "openapi": "3.1.0",
    "info": {
        "title": "Evaluation Service API",
        "description": "API for evaluating student code submissions against predefined test cases",
        "version": "v1.0"
    },
    "servers": [
        {
            "url": "http://localhost:8085",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Evaluation",
            "description": "Code evaluation management"
        }
    ],
    "paths": {
        "/api/v1/runtimes": {
            "get": {
                "tags": [
                    "Evaluation"
                ],
                "summary": "Get supported runtimes",
                "description": "Returns list of all supported programming languages and their versions",
                "operationId": "getSupportedRuntimes",
                "responses": {
                    "200": {
                        "description": "Successfully retrieved runtimes",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/RuntimeResponse"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/RuntimeResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RuntimeResponse": {
                "type": "object",
                "description": "Supported programming language runtime information",
                "properties": {
                    "language": {
                        "type": "string",
                        "description": "Name of the programming language",
                        "example": "java"
                    },
                    "version": {
                        "type": "string",
                        "description": "Version of the runtime",
                        "example": "21.0.0"
                    },
                    "aliases": {
                        "type": "array",
                        "description": "List of alternative names for the language",
                        "example": [
                            "java",
                            "java-21"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "runtime": {
                        "type": "string",
                        "description": "Name of the runtime, only provided if alternative runtimes exist",
                        "example": "openjdk"
                    }
                }
            }
        }
    }
}