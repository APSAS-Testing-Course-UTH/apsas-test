{
    "openapi": "3.1.0",
    "info": {
        "title": "Support Service API",
        "description": "API documentation for the Support Service - Real-time chat support system",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Local server"
        }
    ],
    "tags": [
        {
            "name": "Support",
            "description": "Support session management endpoints"
        }
    ],
    "paths": {
        "/api/v1/support/sessions": {
            "get": {
                "tags": [
                    "Support"
                ],
                "summary": "List all support sessions",
                "description": "Instructors view all sessions with pagination, students view their own",
                "operationId": "listSessions",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number (0-indexed)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "minimum": 0
                        },
                        "example": 0
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "description": "Number of items per page",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "maximum": 100,
                            "minimum": 1
                        },
                        "example": 10
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by field(s). Format: field1,direction;field2,direction. Direction can be 'asc' or 'desc'. Multiple sort criteria separated by semicolon.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "createdAt,desc;name,asc"
                    },
                    {
                        "name": "userId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "email",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "firstName",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "lastName",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "role",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "isActive",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved sessions",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponseSupportSessionDto"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "Bearer Authentication": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Support"
                ],
                "summary": "Create a new support session",
                "description": "Students can create support sessions",
                "operationId": "createSession",
                "parameters": [
                    {
                        "name": "userId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "email",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "firstName",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "lastName",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "role",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "isActive",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateSupportSessionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Session created successfully",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "Bearer Authentication": []
                    }
                ]
            }
        },
        "/api/v1/support/sessions/{id}/close": {
            "post": {
                "tags": [
                    "Support"
                ],
                "summary": "Close a support session",
                "description": "Only the student who created the session can close it",
                "operationId": "closeSession",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "userId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "email",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "firstName",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "lastName",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "role",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "isActive",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Session closed successfully",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Session not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Access denied",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Session already closed",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "Bearer Authentication": []
                    }
                ]
            }
        },
        "/api/v1/support/sessions/{id}": {
            "get": {
                "tags": [
                    "Support"
                ],
                "summary": "Get support session by ID",
                "description": "Instructors can view all, students can view their own",
                "operationId": "getSessionById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "userId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "email",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "firstName",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "lastName",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "role",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "isActive",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved session",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Session not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Access denied",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SupportSessionDto"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "Bearer Authentication": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "CreateSupportSessionRequest": {
                "type": "object",
                "properties": {
                    "initialMessage": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "required": [
                    "initialMessage"
                ]
            },
            "SupportMessageDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "senderId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "content": {
                        "type": "string"
                    },
                    "isInstructor": {
                        "type": "boolean"
                    },
                    "isRead": {
                        "type": "boolean"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "SupportSessionDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "studentId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "instructorId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "isClosed": {
                        "type": "boolean"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "closedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "messages": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SupportMessageDto"
                        }
                    }
                }
            },
            "PageResponseSupportSessionDto": {
                "type": "object",
                "description": "Paginated response wrapper",
                "properties": {
                    "content": {
                        "type": "array",
                        "description": "List of items in the current page",
                        "items": {
                            "$ref": "#/components/schemas/SupportSessionDto"
                        }
                    },
                    "pageNumber": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Current page number (0-indexed)",
                        "example": 0
                    },
                    "pageSize": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Number of items per page",
                        "example": 10
                    },
                    "totalElements": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Total number of items across all pages",
                        "example": 100
                    },
                    "totalPages": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Total number of pages",
                        "example": 10
                    },
                    "first": {
                        "type": "boolean",
                        "description": "Whether this is the first page",
                        "example": true
                    },
                    "last": {
                        "type": "boolean",
                        "description": "Whether this is the last page",
                        "example": false
                    },
                    "hasNext": {
                        "type": "boolean",
                        "description": "Whether there is a next page",
                        "example": true
                    },
                    "hasPrevious": {
                        "type": "boolean",
                        "description": "Whether there is a previous page",
                        "example": false
                    }
                }
            }
        },
        "securitySchemes": {
            "Bearer Authentication": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}