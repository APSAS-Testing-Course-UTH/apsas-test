{
  "openapi": "3.1.0",
  "info": {
    "title": "API APSAS submission-service",
    "description": "Tài liệu API cho APSAS submission-service",
    "version": "1.0"
  },
  "servers": [{ "url": "/", "description": "mặc định" }],
  "tags": [{ "name": "Quản lý bài nộp", "description": "Quản lý và xử lý bài nộp của sinh viên" }],
  "paths": {
    "/api/v1/submissions": {
      "get": {
        "tags": ["Quản lý bài nộp"],
        "summary": "Lấy tất cả bài nộp",
        "description": "Lấy danh sách bài nộp với phân trang và sắp xếp. Sinh viên chỉ xem bài của mình, giảng viên có thể lọc theo bài tập và sinh viên.",
        "operationId": "getAllSubmissions",
        "parameters": [
          {
            "name": "assignmentId",
            "in": "query",
            "description": "Lọc theo ID bài tập (chỉ giảng viên)",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "studentId",
            "in": "query",
            "description": "Lọc theo ID sinh viên (chỉ giảng viên)",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Lọc theo trạng thái",
            "required": false,
            "schema": { "type": "string", "enum": ["PENDING", "EVALUATED", "FAILED"] }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Số trang (bắt đầu từ 0)",
            "required": false,
            "schema": { "type": "string", "minimum": 0 },
            "example": 0
          },
          {
            "name": "size",
            "in": "query",
            "description": "Số lượng phần tử mỗi trang",
            "required": false,
            "schema": { "type": "string", "maximum": 100, "minimum": 1 },
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PageResponseSubmissionResponse" } }
            }
          },
          "default": {
            "description": "Phản hồi lỗi mặc định",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetail" } } }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      },
      "post": {
        "tags": ["Quản lý bài nộp"],
        "summary": "Tạo bài nộp mới",
        "description": "Nộp bài giải cho một bài tập (chỉ sinh viên)",
        "operationId": "createSubmission",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSubmissionRequest" } } },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionResponse" } } }
          },
          "default": {
            "description": "Phản hồi lỗi mặc định",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetail" } } }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/v1/submissions/{id}/feedback": {
      "post": {
        "tags": ["Quản lý bài nộp"],
        "summary": "Thêm nhận xét cho bài nộp",
        "description": "Thêm nhận xét của giảng viên cho bài nộp (chỉ giảng viên)",
        "operationId": "provideFeedback",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionFeedbackRequest" } } },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionResponse" } } }
          },
          "default": {
            "description": "Phản hồi lỗi mặc định",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetail" } } }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/v1/submissions/{id}": {
      "get": {
        "tags": ["Quản lý bài nộp"],
        "summary": "Lấy bài nộp theo ID",
        "description": "Lấy chi tiết bài nộp theo ID. Sinh viên chỉ xem bài của mình, giảng viên xem được tất cả.",
        "operationId": "getSubmissionById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionResponse" } } }
          },
          "default": {
            "description": "Phản hồi lỗi mặc định",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetail" } } }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSubmissionRequest": {
        "type": "object",
        "description": "Yêu cầu tạo bài nộp",
        "properties": {
          "assignmentId": {
            "type": "string",
            "format": "uuid",
            "description": "ID của bài tập",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "code": {
            "type": "string",
            "description": "Mã nguồn của bài nộp (Base64 encoded)",
            "example": "Y29uc29sZS5sb2coJ0hlbGxvIHdvcmxkJyk7",
            "minLength": 1
          },
          "language": { "type": "string", "description": "Ngôn ngữ lập trình", "example": "javascript", "minLength": 1 }
        },
        "required": ["assignmentId", "code", "language"]
      },
      "SubmissionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "assignmentId": { "type": "string", "format": "uuid" },
          "studentId": { "type": "string", "format": "uuid" },
          "submittedAt": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["PENDING", "EVALUATED", "FAILED"] },
          "code": { "type": "string" },
          "language": { "type": "string" },
          "result": { "type": "string", "enum": ["PASSED", "FAILED", "PARTIAL"] },
          "score": { "type": "number" },
          "testCaseResults": { "type": "array", "items": { "$ref": "#/components/schemas/TestCaseResultResponse" } },
          "evaluatedAt": { "type": "string", "format": "date-time" },
          "feedback": { "type": "string" }
        }
      },
      "TestCaseResultResponse": {
        "type": "object",
        "properties": {
          "order": { "type": "integer", "format": "int32" },
          "description": { "type": "string" },
          "hidden": { "type": "boolean" },
          "weight": { "type": "number", "format": "double" },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "timeout": { "type": "integer", "format": "int32" },
          "memoryLimit": { "type": "integer", "format": "int32" },
          "passed": { "type": "boolean" },
          "actualOutput": { "type": "string" },
          "errorMessage": { "type": "string" },
          "executionTime": { "type": "number", "format": "double" },
          "memoryUsed": { "type": "number", "format": "double" }
        }
      },
      "SubmissionFeedbackRequest": {
        "type": "object",
        "properties": { "feedback": { "type": "string", "minLength": 1 } },
        "required": ["feedback"]
      },
      "PageResponseSubmissionResponse": {
        "type": "object",
        "description": "Lớp bọc phản hồi phân trang",
        "properties": {
          "content": {
            "type": "array",
            "description": "Danh sách phần tử trong trang hiện tại",
            "items": { "$ref": "#/components/schemas/SubmissionResponse" }
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32",
            "description": "Số trang hiện tại (bắt đầu từ 0)",
            "example": 0
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "description": "Số lượng phần tử mỗi trang",
            "example": 10
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "description": "Tổng số phần tử trên tất cả các trang",
            "example": 100
          },
          "totalPages": { "type": "integer", "format": "int32", "description": "Tổng số trang", "example": 10 },
          "first": { "type": "boolean", "description": "Có phải trang đầu tiên không", "example": true },
          "last": { "type": "boolean", "description": "Có phải trang cuối cùng không", "example": false },
          "hasNext": { "type": "boolean", "description": "Có trang tiếp theo không", "example": true },
          "hasPrevious": { "type": "boolean", "description": "Có trang trước đó không", "example": false }
        }
      },
      "ProblemDetail": {
        "description": "Chi tiết lỗi theo chuẩn RFC 9457",
        "properties": {
          "type": { "format": "uri", "description": "Loại lỗi (URI)" },
          "title": { "description": "Tiêu đề lỗi" },
          "status": { "format": "int32", "description": "Mã trạng thái HTTP" },
          "detail": { "description": "Mô tả chi tiết lỗi" },
          "instance": { "format": "uri", "description": "Đường dẫn instance lỗi" }
        }
      }
    },
    "securitySchemes": { "Bearer Authentication": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } }
  }
}
