# ===============================================================================
# APSAS FRONTEND - Environment Configuration Template (.env.local.example)
# ===============================================================================
# 
# Đây là template file để tạo file .env.local của bạn
# 
# HƯỚNG DẪN SỬ DỤNG:
# 1. Copy file này thành .env.local:
#    cp .env.local.example .env.local
# 
# 2. Điền các giá trị thật vào .env.local (không commit file .env.local)
# 
# 3. Các biến có prefix VITE_ sẽ được expose cho client (browser)
#    Không để thông tin nhạy cảm vào các biến này!
# 
# ===============================================================================


# ===============================================================================
# 1. API CONFIGURATION - Cấu hình API Backend
# ===============================================================================

# Base URL cho Backend API
# 
# Options:
#   - MSW Mock (development): http://localhost:8080
#   - Local BE-Docker: http://localhost:8080 (hoặc port khác tùy setup)
#   - Remote Backend: https://api.apsas.com (hoặc staging URL)
# 
# Lưu ý: URL này phải match với Backend đang chạy
# Nếu sai URL sẽ gặp CORS error hoặc connection timeout
VITE_API_BASE_URL=http://localhost:8080

# Timeout cho tất cả API requests (milliseconds)
# 
# Min: 1000 (1 giây)
# Max: 120000 (2 phút)
# 
# Recommend:
#   - Local Dev/MSW: 10000 (10 giây)
#   - Slow Network: 30000 (30 giây)
#   - Production: 15000 (15 giây)
# 
# Nếu hay gặp timeout error, tăng giá trị này
VITE_API_TIMEOUT=10000


# ===============================================================================
# 2. APPLICATION CONFIGURATION - Cấu hình ứng dụng
# ===============================================================================

# Tên ứng dụng (hiển thị trong UI, browser tab, notifications)
# Không nên thay đổi trừ khi cần rebrand
VITE_APP_NAME=APSAS

# Version ứng dụng (semantic versioning: MAJOR.MINOR.PATCH)
# Dùng để tracking, logging, troubleshooting
# 
# Ví dụ: 1.0.0, 1.2.3, 2.0.0-beta
VITE_APP_VERSION=1.0.0

# Environment type - môi trường chạy
# 
# Options: development | staging | production
# 
# - development: Dev mode, debug logs enabled, MSW mock có thể enable
# - staging: Staging server, gần giống production
# - production: Production, tối ưu hiệu năng, no debug, no MSW
# 
# Hiện tại khuyến nghị: development (cho local testing)
VITE_APP_ENV=development


# ===============================================================================
# 3. DEVELOPMENT TOOLS - Công cụ phát triển
# ===============================================================================

# React DevTools và debug logs
# 
# - true: Hiển thị console logs, debug info, easier troubleshooting
# - false: Ẩn debug logs (production mode)
# 
# Khuyến nghị: true trong development
VITE_ENABLE_DEVTOOLS=true

# Mock Service Worker (MSW) - Giả lập Backend API
# 
# MSW cho phép:
#   ✅ Chạy frontend KHÔNG CẦN backend Docker
#   ✅ Mock API responses để test UI
#   ✅ Bypass network requests cho testing
# 
# - true: Dùng MSW mock (backend KHÔNG CẦN chạy)
# - false: Dùng REAL Backend API (backend PHẢI CHẠY)
# 
# QUAN TRỌNG:
#   - Để test UI logic only: VITE_ENABLE_MSW=true
#   - Để test với real backend: VITE_ENABLE_MSW=false
#   - Nếu backend Docker không chạy nhưng set false → sẽ gặp connection error
# 
# Khuyến nghị:
#   - Khi backend chưa setup: true
#   - Khi đã có backend running: false (để test integration)
VITE_ENABLE_MSW=true


# ===============================================================================
# 4. FIREBASE CONFIGURATION - Push Notifications
# ===============================================================================

# Firebase Cloud Messaging - VAPID Public Key
# 
# ⚠️ Key này là PUBLIC key (an toàn để expose trong browser)
# Dùng để enable Web Push Notifications từ Firebase
# 
# Lấy từ: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
# 
# Format: Base64-encoded string (~80 characters)
# 
# Ví dụ (KHÔNG dùng key này trong production - chỉ là example):
# VITE_FIREBASE_VAPID_KEY=BN-tBfXeYExFIrrw-EPVAqN58o5dpkHiEK16j5dfkKS9jKr6RLm-Y10890LWW0kyRfc1Aq9qH5A4yjhogF6RSEo
# 
# ⚠️ Bạn PHẢI thay bằng VAPID key thật từ Firebase Console của bạn
VITE_FIREBASE_VAPID_KEY=YOUR_FIREBASE_VAPID_PUBLIC_KEY_HERE


# ===============================================================================
# 5. FEATURE FLAGS - Công tắc tính năng
# ===============================================================================

# Bật/Tắt hệ thống xác thực (Authentication)
# 
# - true: Bật Auth (yêu cầu login, protected routes, JWT tokens)
# - false: Tắt Auth (skip login, public access - CHỈ cho testing)
# 
# Luôn giữ true vì ứng dụng APSAS yêu cầu authentication
VITE_ENABLE_AUTH=true

# Bật/Tắt hệ thống notification (toast messages)
# 
# - true: Hiển thị success/error/info notifications
# - false: Ẩn tất cả toast notifications
# 
# Khuyến nghị: true (giúp user biết action success/fail)
VITE_ENABLE_NOTIFICATIONS=true

# Bật/Tắt WebSocket connections (Real-time chat trong Support)
# 
# WebSocket dùng để:
#   - Real-time chat trong Support feature
#   - Live notifications
#   - Instant message updates
# 
# - true: Kết nối WebSocket (cần Backend Support Service port 8085)
# - false: Dùng REST API polling fallback (chậm hơn nhưng stable hơn)
# 
# Khuyến nghị:
#   - Development: false (tránh errors khi backend không chạy)
#   - Production: true (để real-time features hoạt động)
# 
# ⚠️ Nếu gặp WebSocket connection errors, set thành false
VITE_ENABLE_WEBSOCKET=false

# WebSocket URL cho Support Service (Real-time Chat)
# 
# Format: http://HOSTNAME:PORT/ws/support hoặc https://...
# 
# Ví dụ:
#   - Local Docker: http://localhost:8085/ws/support
#   - Container network: http://support-service:8085/ws/support
#   - Remote: https://api.apsas.com/ws/support
# 
# ⚠️ CHỈ dùng khi VITE_ENABLE_WEBSOCKET=true
# Nếu Support Service không chạy, set VITE_ENABLE_WEBSOCKET=false
VITE_WEBSOCKET_URL=http://localhost:8085/ws/support


# ===============================================================================
# 6. ADMIN PORTAL CONFIGURATION - Cấu hình Admin Portal
# ===============================================================================

# Admin Portal URL - Server-side MVC application
# 
# Admin users sẽ được redirect đến Admin Portal riêng biệt (server-side)
# thay vì sử dụng React SPA này
# 
# Format: http://HOSTNAME:PORT hoặc https://...
# 
# Ví dụ:
#   - Local Docker: http://localhost:8081
#   - Remote: https://admin.apsas.com
# 
# Admin login flow:
#   1. User login với ADMIN role trong React app
#   2. Frontend redirect đến {ADMIN_PORTAL_URL}/auth/token-login?token=<JWT>
#   3. Admin portal server:
#      - Validates JWT token
#      - Creates server-side session (HttpOnly cookie)
#      - Redirects to admin dashboard
#   4. Admin có thể sử dụng admin portal với session
# 
# Admin Portal Backend Requirements:
#   - Endpoint: GET /auth/token-login
#   - Query param: token (JWT access token)
#   - Response: Redirect to admin dashboard with session cookie
#   - CSRF: Không cần CSRF token cho GET request với JWT validation
VITE_ADMIN_PORTAL_URL=http://localhost:9090


# ===============================================================================
# 7. SECURITY CONFIGURATION - Cấu hình bảo mật
# ===============================================================================

# Content Security Policy (CSP)
# 
# CSP là security header giúp prevent XSS attacks
# 
# - true: Bật CSP (khuyến nghị cho production)
# - false: Tắt CSP (easier cho development, ít warnings)
# 
# Khuyến nghị:
#   - Development: false (để tránh CSP violation warnings)
#   - Production: true (để enhance security)
VITE_CSP_ENABLED=false


# ===============================================================================
# 8. ANALYTICS (Optional) - Phân tích người dùng
# ===============================================================================

# Google Analytics Tracking ID
# 
# Format: G-XXXXXXXXXX hoặc UA-XXXXXXXXX-X
# 
# Bỏ trống hoặc comment out nếu không dùng Google Analytics
# 
# Ví dụ: VITE_GA_TRACKING_ID=G-ABC123DEF4
# VITE_GA_TRACKING_ID=


# ===============================================================================
# SETUP & TROUBLESHOOTING GUIDE
# ===============================================================================
#
# 📖 QUICK START (chạy ngay được):
# 
# 1. Copy file này thành .env.local:
#    cp .env.local.example .env.local
# 
# 2. Điền các giá trị thật vào .env.local (đặc biệt là VITE_FIREBASE_VAPID_KEY)
# 
# 3. Chạy frontend:
#    bun run dev
# 
# 4. Mở browser: http://localhost:5173 (Vite default port)
# 
# 5. Đăng nhập với mock accounts (xem MOCK-ACCOUNTS-GUIDE.md)
#
#
# 🐳 NẾU BACKEND DOCKER CHẠY:
# 
# 1. Set VITE_ENABLE_MSW=false (để dùng real backend)
# 
# 2. Kiểm tra VITE_API_BASE_URL trỏ đúng backend URL
#    (thường là http://localhost:8080 hoặc http://localhost:PORT)
# 
# 3. Đảm bảo backend services đã chạy:
#    docker ps   # Check running containers
#    docker-compose logs   # Check backend logs
# 
# 4. Restart frontend:
#    bun run dev
#
#
# 🔧 TROUBLESHOOTING - Xử lý lỗi thường gặp:
# 
# ❌ "API request timeout" error:
#    → Tăng VITE_API_TIMEOUT (thử 20000 = 20 giây)
#    → Kiểm tra backend có chạy: docker ps
#    → Test backend URL: curl http://localhost:8080/actuator/health
# 
# ❌ "CORS error" khi call API:
#    → Backend CORS config sai
#    → Check backend logs
#    → Tạm thời set VITE_ENABLE_MSW=true để test UI
# 
# ❌ "WebSocket connection failed":
#    → Set VITE_ENABLE_WEBSOCKET=false (dùng REST fallback)
#    → Kiểm tra Support Service port 8085
#    → Thường OK nếu chỉ test non-chat features
# 
# ❌ "Cannot connect to localhost:8080":
#    → Backend Docker không chạy
#    → Set VITE_ENABLE_MSW=true để test UI without backend
#    → Hoặc set VITE_API_BASE_URL đúng IP/port
# 
# ❌ "Module not found" hoặc build error:
#    → Xóa node_modules: rm -rf node_modules
#    → Reinstall: bun install
#    → Xóa cache: rm -rf dist .vite
#    → Restart: bun run dev
# 
# ❌ "Environment variable not defined":
#    → Kiểm tra tất cả biến có prefix VITE_
#    → Restart dev server sau khi sửa .env.local
#    → Verify trong browser console: console.log(import.meta.env)
#
#
# 💡 DEVELOPMENT TIPS:
# 
# - Dùng Chrome DevTools (F12) để debug
# - Install React DevTools extension
# - Mantine UI DevTools built-in (inspect colors, themes)
# - MSW DevTools (Network tab, xem mock handlers)
# - Ctrl+Shift+K để mở DevTools Console nhanh
# 
# 
# 📚 DOCUMENTATION:
# 
# - Backend API Docs: docs/docs-apsas/
# - OpenAPI Specs: openapi/
# - Alignment Checklist: docs/BE-FE-ALIGNMENT-CHECKLIST.md
# - Feature Requirements: docs/docs-apsas/function-requirements.md
# 
# 
# ⚠️ SECURITY NOTES:
# 
# - File .env.local KHÔNG được commit lên git (đã có trong .gitignore)
# - KHÔNG để sensitive data (passwords, private keys) vào biến VITE_*
# - VITE_* variables được expose ra browser (client-side)
# - Chỉ để public data trong VITE_* variables
# - Private secrets phải để ở backend
# 
# ===============================================================================
