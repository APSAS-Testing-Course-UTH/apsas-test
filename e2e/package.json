{
  "name": "apsas-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for APSAS using CodeceptJS + Playwright",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node ./scripts/setup-playwright.cjs",
    "setup:playwright": "node ./scripts/setup-playwright.cjs",
    "test": "codeceptjs run --steps",
    "pretest:real": "bun run setup:playwright",
    "test:real": "APP_URL=http://localhost:5173 codeceptjs run --steps",
    "test:ui": "codeceptjs run --steps --reporter mochawesome",
    "test:parallel": "codeceptjs run-workers 2",
    "test:allure": "bun run test && bun run allure:generate",
    "stack:up": "docker compose -f ./docker-compose.e2e.yaml up -d --wait --wait-timeout 600 && wait-on http://localhost:5173",
    "stack:down": "docker compose -f ./docker-compose.e2e.yaml down --remove-orphans",
    "pretest:e2e": "bun run stack:up",
    "test:e2e": "bun run test:real",
    "posttest:e2e": "bun run stack:down",
    "test:ci": "bun run test:e2e",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results"
  },
  "dependencies": {
    "@codeceptjs/configure": "^1.0.6",
    "allure-codeceptjs": "^3.7.1",
    "allure-commandline": "^2.38.1",
    "codeceptjs": "^3.7.8",
    "playwright": "^1.59.1",
    "wait-on": "^9.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}