{
  "name": "apsas-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for APSAS using CodeceptJS + Playwright",
  "type": "commonjs",
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "codeceptjs run --steps",
    "test:real": "APP_URL=http://localhost:5173 codeceptjs run --steps",
    "test:ui": "codeceptjs run --steps --reporter mochawesome",
    "test:parallel": "codeceptjs run-workers 2",
    "test:allure": "npm run test && npm run allure:generate",
    "stack:up": "docker compose -f ./docker-compose.e2e.yaml up -d --wait --wait-timeout 600",
    "stack:down": "docker compose -f ./docker-compose.e2e.yaml down --remove-orphans",
    "test:e2e": "sh -c 'code=0; npm run stack:up || code=$?; if [ \"$code\" -eq 0 ]; then npm run test:real || code=$?; fi; npm run stack:down; exit \"$code\"'",
    "test:ci": "npm run test:e2e",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results"
  },
  "dependencies": {
    "@codeceptjs/configure": "^1.0.6",
    "allure-codeceptjs": "^3.7.1",
    "allure-commandline": "^2.38.1",
    "codeceptjs": "^3.7.8",
    "playwright": "^1.49.0",
    "start-server-and-test": "^3.0.0"
  }
}
