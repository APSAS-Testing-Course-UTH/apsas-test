{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "strictNullChecks": false,
    "lib": ["DOM", "ESNext"],
    "types": ["node", "codeceptjs"],
    "rootDir": "./"
  },
  "ts-node": {
    "files": true
  },
  "include": ["./tests/**/*.ts", "./steps_file.ts", "./steps.d.ts", "./codecept.conf.ts", "./bootstrap.ts"],
  "exclude": ["node_modules"]
}
